# LLM provider: openai | anthropic
LLM_PROVIDER=openai

# API keys (set the one matching your provider; OpenAI key also powers embeddings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Chat model
LLM_MODEL=gpt-4o-mini

# Embeddings (OpenAI only; Anthropic has no embeddings API)
EMBEDDING_MODEL=text-embedding-3-small

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval (MMR)
RETRIEVER_K=6
FETCH_K=20
MMR_LAMBDA=0.5

# Conversation memory (turns kept per session)
MEMORY_WINDOW=10

# Pre-indexed sample paper for the landing demo widget
SEED_PAPER=./data/seed/sample.pdf

# Storage paths
DATA_DIR=./data
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
